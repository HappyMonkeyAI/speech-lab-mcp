# MCP transport: stdio (Cursor local) or streamable-http (Compose / remote)
SPEECH_LAB_TRANSPORT=stdio
SPEECH_LAB_HOST=127.0.0.1
SPEECH_LAB_PORT=8765

# Where synthesized WAVs are written (returned as absolute paths)
SPEECH_LAB_OUTPUT_DIR=./data/out

# Leave a URL empty to disable that provider
SPEECH_LAB_PIPER_URL=http://127.0.0.1:8090
SPEECH_LAB_POCKET_URL=http://127.0.0.1:8091
SPEECH_LAB_WOOF_URL=http://127.0.0.1:8092

SPEECH_LAB_HTTP_TIMEOUT_S=60
SPEECH_LAB_MAX_WAV_BYTES=52428800

# Cartesia (cloud) — leave empty to disable. Never commit a real key.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.5
CARTESIA_SAMPLE_RATE=24000

# Optional Hugging Face token for Pocket/Woof model pulls (local only)
# HF_TOKEN=

# Woof profile only: path to ConwayResearch/Underdog-Woof checkout
# WOOF_MODEL_DIR=

# Optional defaults for synthesize when voice is omitted
SPEECH_LAB_DEFAULT_PROVIDER=piper
SPEECH_LAB_DEFAULT_VOICE=
